#!/bin/bash
screenshot="/Users/ori/Pictures/Screenshots/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"

if screencapture -i "$screenshot"; then
  osascript \
    -e 'on run argv' \
    -e 'set the clipboard to (read (POSIX file (item 1 of argv)) as «class PNGf»)' \
    -e 'end run' \
    "$screenshot"
fi
